+
+// Match /codex-accounts use 1|2|3 at each tool call, not at extension startup.
+export function selectedCodexProvider(agentDir = getAgentDir()): string {
+	let preference: { account?: unknown };
+	try {
+		preference = JSON.parse(readFileSync(join(agentDir, "codex-accounts", "preference.json"), "utf8"));
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ENOENT") return PROVIDER;
+		throw new Error("Codex account preference cannot be read. Run /codex-accounts use 1|2|3 again.");
+	}
+	if (preference?.account !== 1 && preference?.account !== 2 && preference?.account !== 3) {
+		throw new Error("Invalid Codex account preference. Run /codex-accounts use 1|2|3 again.");
+	}
+	return preference.account === 1 ? PROVIDER : `${PROVIDER}-${preference.account}`;
+}
