--- /dev/null
+++ b/permission-state.ts
@@ -0,0 +1,34 @@
+import { spawnSync } from "node:child_process";
+
+const paneId = process.env.TMUX_PANE;
+let waitingDepth = 0;
+
+function publish(waiting: boolean): void {
+  if (!paneId || !process.env.TMUX) return;
+  try {
+    const value = waiting ? `mcp:${process.pid}` : "0";
+    spawnSync("tmux", ["set-option", "-p", "-t", paneId, "@pi_permission_waiting", value], {
+      stdio: "ignore",
+      timeout: 250,
+    });
+  } catch {
+    // Permission UI must remain usable even if tmux state publication fails.
+  }
+}
+
+/** Publish the lifecycle of a real MCP interaction, never inferred screen text. */
+export function clearMcpPermissionWaiting(): void {
+  waitingDepth = 0;
+  publish(false);
+}
+
+export async function withMcpPermissionWaiting<T>(operation: () => Promise<T>): Promise<T> {
+  waitingDepth += 1;
+  if (waitingDepth === 1) publish(true);
+  try {
+    return await operation();
+  } finally {
+    waitingDepth = Math.max(0, waitingDepth - 1);
+    if (waitingDepth === 0) publish(false);
+  }
+}
